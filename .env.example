# Banco de dados local (suba com: docker compose up -d db)
DATABASE_URL=postgresql+psycopg://estoque:estoque@localhost:5432/estoque

# Segredo do JWT — gere um valor forte e NUNCA commite o .env (só o .env.example)
JWT_SECRET=troque-por-um-segredo-forte-com-32-bytes-ou-mais
JWT_EXPIRE_MINUTES=60

# Admin semeado por `uv run python -m app.seed` (valores reais só no .env local)
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Leitor semeado pelo mesmo comando (ADR-0016) — usado para demonstrar o 403
LEITOR_EMAIL=leitor@exemplo.com
LEITOR_PASSWORD=troque-por-uma-senha-forte

# Front-end (painel FastHTML em :5001 — ADR-0014)
API_URL=http://localhost:8000
SESSION_SECRET=troque-por-um-segredo-forte-com-32-bytes-ou-mais
SESSION_COOKIE=painel_sessao

# Testes: por padrão a suíte usa o banco irmão `<DATABASE_URL>_test` (criado se
# faltar). Defina TEST_DATABASE_URL só se quiser apontar para outro banco.
# TEST_DATABASE_URL=postgresql+psycopg://estoque:estoque@localhost:5432/estoque_test
